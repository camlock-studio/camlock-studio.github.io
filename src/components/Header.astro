---
import Logo from './Logo.astro';
import StoreCta from './StoreCta.astro';
import { SITE, url } from '../consts';
---
<header>
  <div class="wrap bar">
    <a class="brand" href={url('/')}>
      <Logo size={26} />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Primary">
      <a href={url('/#how')}>How it works</a>
      <a href={url('/#features')}>Features</a>
      <a href={url('/#privacy')}>Privacy</a>
      <a href={url('/#faq')}>FAQ</a>
    </nav>
    <StoreCta variant="pill" />
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    transition: background 0.35s var(--ease), border-color 0.35s var(--ease), backdrop-filter 0.35s;
    border-bottom: 1px solid transparent;
  }
  header.stuck {
    background: rgba(7, 13, 15, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line-soft);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }
  nav { display: flex; gap: 1.6rem; }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.925rem;
    transition: color 0.2s;
  }
  nav a:hover { color: var(--text); }
  @media (max-width: 52rem) {
    nav { display: none; }
  }
  /* Below this the mark, the wordmark and the call to action stop fitting on one
     line. The hero repeats the call to action a screenful later, so it goes. */
  @media (max-width: 21rem) {
    .bar :global(.pill) { display: none; }
  }
</style>
