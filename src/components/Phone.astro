---
import { url } from '../consts';

/**
 * The product visual. Four screens that mirror the real app (docs/DESIGN.md):
 * enrolment, Home while armed, a live check, and the child-facing lock screen.
 *
 * `mode="loop"`  cycles by itself, used in the hero.
 * `mode="scroll"` is driven by whatever sets data-step on it.
 * `mode="static"` just shows the screen it was given.
 * `tilt` renders it as a 3D object: turned, with a real side edge and a sheen.
 */
interface Props {
  mode?: 'loop' | 'scroll' | 'static';
  id?: string;
  step?: number;
  tilt?: boolean;
}
const { mode = 'scroll', id, step = 0, tilt = false } = Astro.props;
// The side edge is a stack of thin slices behind the front face; with the phone
// turned in 3D their offsets read as a solid body. Only built when tilted.
const SLICES = 24;   // 24 x 1.2px ~ 29px, about 10% of the width like a real phone
const scanPhoto = url('img/scan-face.webp');
const enrolShot = url('img/app-enrol.webp');
const homeShot = url('img/app-home.webp');
const lockShot = url('img/app-lock.webp');
---

<div class="phone" data-step={step} data-mode={mode} id={id} data-tilt={tilt ? '' : undefined}>
  <div class="glow" aria-hidden="true"></div>
  {tilt && (
    <div class="body" aria-hidden="true">
      {Array.from({ length: SLICES }).map((_, i) => (
        <i style={`--z:${-(i + 1) * 1.2}px;--k:${i / (SLICES - 1)}`}></i>
      ))}
    </div>
  )}
  <div class="frame">
    {tilt && <div class="sheen" aria-hidden="true"></div>}
    <div class="notch" aria-hidden="true"></div>

    <!-- 0 · Enrolment and 1 · Home: real renders of EnrollContent and HomeContent
         from the app (scripts/capture-app-screens.sh). The status bar and gesture
         handle are drawn here, over the band the app leaves empty for them. -->
    <div class="screen app" data-i="0" aria-hidden="true" style={`--shot: url('${enrolShot}')`}>
      <div class="sbar"><span>14:02</span>
        <span class="sicons">
          <svg viewBox="0 0 16 12"><path d="M8 11.5 1 4.2a9.9 9.9 0 0 1 14 0Z" /></svg>
          <svg viewBox="0 0 14 12"><path d="M1 11h2V8H1zm3.5 0h2V6h-2zM8 11h2V3.5H8zm3.5 0h2V1h-2z" /></svg>
          <svg viewBox="0 0 22 12" class="bat"><rect x="0.6" y="0.6" width="18" height="10.8" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.2" /><rect x="2.2" y="2.2" width="12.4" height="7.6" rx="1.4" /><rect x="19.6" y="4" width="1.8" height="4" rx="0.8" /></svg>
        </span>
      </div>
      <div class="gesture"></div>
    </div>
    <div class="screen app" data-i="1" aria-hidden="true" style={`--shot: url('${homeShot}')`}>
      <div class="sbar"><span>14:02</span>
        <span class="sicons">
          <svg viewBox="0 0 16 12"><path d="M8 11.5 1 4.2a9.9 9.9 0 0 1 14 0Z" /></svg>
          <svg viewBox="0 0 14 12"><path d="M1 11h2V8H1zm3.5 0h2V6h-2zM8 11h2V3.5H8zm3.5 0h2V1h-2z" /></svg>
          <svg viewBox="0 0 22 12" class="bat"><rect x="0.6" y="0.6" width="18" height="10.8" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.2" /><rect x="2.2" y="2.2" width="12.4" height="7.6" rx="1.4" /><rect x="19.6" y="4" width="1.8" height="4" rx="0.8" /></svg>
        </span>
      </div>
      <div class="gesture"></div>
    </div>

    <!-- 2 · Checking -->
    <div class="screen scan" data-i="2" aria-hidden="true" style={`--photo: url('${scanPhoto}')`}>
      <span class="privacy"><i></i>Camera in use</span>
      <div class="reticle">
        {/* The target box frames the face in the photo; landmark dots sit on the
            eyes, nose and mouth corners, as percentages of that box. */}
        <div class="target">
          <span class="corner tl"></span><span class="corner tr"></span>
          <span class="corner bl"></span><span class="corner br"></span>
          <i class="mark" style="--x:34%;--y:52%"></i>
          <i class="mark" style="--x:63%;--y:52%"></i>
          <i class="mark" style="--x:49%;--y:64%"></i>
          <i class="mark" style="--x:38%;--y:76%"></i>
          <i class="mark" style="--x:61%;--y:76%"></i>
          <span class="sweep"></span>
        </div>
      </div>
      <div class="match">
        <div class="mrow"><span>Match</span><b>0.87</b></div>
        <div class="meter"><span></span></div>
        <div class="verdict">Max recognised · 2 frames</div>
      </div>
    </div>

    <!-- 3 · Locked: the real LockScreen render (scripts/capture-app-screens.sh).
         The app draws edge to edge, so the status bar and gesture handle show over
         it. The halo is added here because a still render cannot breathe. -->
    <div class="screen app lock" data-i="3" aria-hidden="true" style={`--shot: url('${lockShot}')`}>
      <div class="sbar"><span>14:02</span>
        <span class="sicons">
          <svg viewBox="0 0 16 12"><path d="M8 11.5 1 4.2a9.9 9.9 0 0 1 14 0Z" /></svg>
          <svg viewBox="0 0 14 12"><path d="M1 11h2V8H1zm3.5 0h2V6h-2zM8 11h2V3.5H8zm3.5 0h2V1h-2z" /></svg>
          <svg viewBox="0 0 22 12" class="bat"><rect x="0.6" y="0.6" width="18" height="10.8" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.2" /><rect x="2.2" y="2.2" width="12.4" height="7.6" rx="1.4" /><rect x="19.6" y="4" width="1.8" height="4" rx="0.8" /></svg>
        </span>
      </div>
      <span class="halo"></span>
      <div class="gesture"></div>
    </div>
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: min(302px, 76vw);
    aspect-ratio: 9 / 19.2;
    flex: none;
  }
  .glow {
    position: absolute;
    inset: -18% -32%;
    background: radial-gradient(closest-side, rgba(95, 212, 232, 0.28), transparent 72%);
    filter: blur(14px);
    opacity: 0.9;
    pointer-events: none;
  }
  .frame {
    position: absolute;
    inset: 0;
    border-radius: 42px;
    padding: 9px;
    background: linear-gradient(160deg, #2a3638, #10191b 42%, #1c2729);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 40px 80px -30px rgba(0, 0, 0, 0.9),
      0 0 60px -20px var(--glow);
  }
  /* ── Tilted: a 3D object ── */
  .phone[data-tilt] {
    transform-style: preserve-3d;
    transform: rotateY(-15deg) rotateX(5deg) rotateZ(1.5deg);
    transition: transform 0.8s var(--ease);
  }
  .phone[data-tilt] .frame { transform: translateZ(0); }
  .phone[data-tilt] .glow { transform: translateZ(-40px); }
  /* The body: slices of the frame colour, darker toward the back, stepped
     back in Z so the turned phone shows a solid aluminium edge. */
  .body, .body i { position: absolute; inset: 0; border-radius: 42px; }
  .body { transform-style: preserve-3d; }
  .body i {
    transform: translateZ(var(--z));
    /* Brushed-metal band: bright near the front, falling off toward the back. */
    background: linear-gradient(160deg,
      color-mix(in srgb, #5b6d70 calc(100% - var(--k) * 75%), #0b1213),
      color-mix(in srgb, #2a3a3d calc(100% - var(--k) * 75%), #050909));
  }
  /* The last slice carries the drop shadow, so it falls from the back of the body. */
  .body i:last-child { box-shadow: 30px 50px 70px -20px rgba(0, 0, 0, 0.85); }
  .phone[data-tilt] .frame {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.14),
      inset 1px 1px 0 rgba(255, 255, 255, 0.10),
      0 0 60px -20px var(--glow);
  }
  /* Glass: a soft diagonal highlight over the screen. */
  .sheen {
    position: absolute;
    inset: 9px;
    border-radius: 34px;
    z-index: 5;
    pointer-events: none;
    background: linear-gradient(115deg,
      rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.03) 28%,
      transparent 42%, transparent 100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .phone[data-tilt] { animation: drift 9s ease-in-out infinite; }
    @keyframes drift {
      0%, 100% { transform: rotateY(-15deg) rotateX(5deg) rotateZ(1.5deg) translateY(0); }
      50% { transform: rotateY(-10deg) rotateX(4deg) rotateZ(1deg) translateY(-8px); }
    }
  }

  .notch {
    position: absolute;
    top: 16px; left: 50%;
    width: 8px; height: 8px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #05090a;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);
    z-index: 4;
  }

  .screen {
    position: absolute;
    inset: 9px;
    border-radius: 34px;
    padding: 30px 16px 18px;
    display: flex;
    flex-direction: column;
    background: #0a1113;
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);
    pointer-events: none;
    overflow: hidden;
    font-size: 12px;
  }
  .phone[data-step='0'] .screen[data-i='0'],
  .phone[data-step='1'] .screen[data-i='1'],
  .phone[data-step='2'] .screen[data-i='2'],
  .phone[data-step='3'] .screen[data-i='3'] { opacity: 1; transform: none; }

  /* ── App screens (0 Enrolment, 1 Home): screenshots of the real app ────── */
  .app {
    padding: 0;
    justify-content: space-between;
    /* Top-anchored so the app's empty status-bar band sits under the status bar
       below. The shot is 1080 x 2424, a hair taller than the screen, so a few px
       of the navigation-bar band are cropped at the bottom. */
    background: #0f1415 var(--shot) center top / cover no-repeat;
    color: #dfe3e3;
  }
  .sbar {
    height: 26px; flex: none;
    display: flex; align-items: center; justify-content: space-between;
    padding: 2px 20px 0 22px;
    font-size: 9.5px; font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .sicons { display: inline-flex; align-items: center; gap: 4px; }
  .sicons svg { height: 8px; width: auto; fill: currentColor; }
  .gesture {
    flex: none; align-self: center;
    width: 72px; height: 3px; border-radius: 3px;
    background: rgba(223, 227, 227, 0.45);
    margin-bottom: 6px;
  }

  /* ── 2 Checking ── */
  /* The front-camera frame: a graded portrait (public/img/scan-face.webp, made
     from docs/image.png) filling the screen, with the scan overlay on top. */
  .scan {
    background: #070d0f var(--photo) center / cover no-repeat;
    padding-top: 26px;
  }
  .privacy {
    align-self: flex-end;
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 9px; color: #d9e6e8;
    background: rgba(0,0,0,0.5);
    border-radius: 999px; padding: 3px 8px;
  }
  .privacy i { width: 6px; height: 6px; border-radius: 50%; background: #5bd07f; animation: blink 1.4s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }

  /* The reticle only reserves the space between the chip and the match card;
     the target is placed against the whole screen so it lines up with the photo. */
  .reticle { flex: 1; }
  .target {
    position: absolute;
    top: 20%; bottom: 38%;
    left: 18%; right: 18%;
  }
  .mark {
    position: absolute;
    left: var(--x); top: var(--y);
    width: 4px; height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 6px 1px var(--glow);
    opacity: 0;
  }
  .phone[data-step='2'] .mark { animation: mark 2.4s var(--ease) infinite; }
  @keyframes mark { 0%, 30% { opacity: 0; transform: scale(0.4); } 50%, 90% { opacity: 0.9; transform: none; } 100% { opacity: 0; } }
  .corner {
    position: absolute;
    width: 20px; height: 20px;
    border: 2px solid var(--brand);
  }
  .tl { top: 0; left: 0; border-right: 0; border-bottom: 0; border-radius: 6px 0 0 0; }
  .tr { top: 0; right: 0; border-left: 0; border-bottom: 0; border-radius: 0 6px 0 0; }
  .bl { bottom: 0; left: 0; border-right: 0; border-top: 0; border-radius: 0 0 0 6px; }
  .br { bottom: 0; right: 0; border-left: 0; border-top: 0; border-radius: 0 0 6px 0; }
  .phone[data-step='2'] .corner { animation: lockon 2.4s var(--ease) infinite; }
  @keyframes lockon { 0%, 100% { opacity: 0.55; } 45% { opacity: 1; } }

  .sweep {
    position: absolute;
    left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--brand), transparent);
    box-shadow: 0 0 18px 3px var(--glow);
    opacity: 0;
  }
  .phone[data-step='2'] .sweep { animation: sweep 2.4s ease-in-out infinite; }
  @keyframes sweep {
    0% { top: 0; opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  .match {
    border-radius: 16px;
    padding: 12px 14px;
    background: rgba(8, 20, 23, 0.85);
    border: 1px solid rgba(127, 211, 230, 0.25);
  }
  .mrow { display: flex; justify-content: space-between; align-items: baseline; font-size: 10.5px; color: var(--muted); }
  .mrow b { font-size: 15px; color: var(--brand); letter-spacing: -0.02em; }
  .meter { height: 4px; border-radius: 999px; background: rgba(255,255,255,0.1); margin: 8px 0 7px; overflow: hidden; }
  .meter span { display: block; height: 100%; width: 0; border-radius: inherit; background: linear-gradient(90deg, var(--brand-deep), var(--brand)); }
  .phone[data-step='2'] .meter span { animation: meter 2.4s var(--ease) infinite; }
  @keyframes meter { 0% { width: 4%; } 55%, 100% { width: 87%; } }
  .verdict { font-size: 10px; color: var(--brand); }

  /* ── 3 Locked: screenshot, plus the app's breathing halo ──
     LockSeal is 56dp in a 1.6x halo box: 235px of the 1080px render (21.8% of
     the width), centred at 50% / 37.5%. The render already holds the halo at
     rest; this adds the app's 1.7s swell (scale to 1.18 while fading) on top. */
  .lock .halo {
    position: absolute;
    left: 50%; top: 37.5%;
    width: 21.8%; aspect-ratio: 1;
    margin: 0;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(127, 211, 230, 0.32), transparent);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .phone[data-step='3'] .lock .halo { animation: halo 1.7s ease-in-out infinite alternate; }
  }
  @keyframes halo {
    from { transform: translate(-50%, -50%) scale(1); opacity: 0; }
    to { transform: translate(-50%, -50%) scale(1.18); opacity: 0.55; }
  }
</style>

<script>
  // Hero phone: advance by itself, but only while visible and only when the
  // viewer has not asked for reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.phone[data-mode="loop"]').forEach((el) => {
    if (reduce) {
      el.dataset.step = '3';
      return;
    }
    const order = ['1', '2', '3'];
    const hold = [2600, 3400, 4200];
    let i = 0;
    let timer = 0;
    const tick = () => {
      el.dataset.step = order[i];
      timer = window.setTimeout(tick, hold[i]);
      i = (i + 1) % order.length;
    };
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !timer) tick();
        else if (!e.isIntersecting) {
          clearTimeout(timer);
          timer = 0;
        }
      },
      { threshold: 0.25 },
    );
    io.observe(el);
  });
</script>
