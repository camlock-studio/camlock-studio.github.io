---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import Flow from '../components/Flow.astro';
import StoreCta from '../components/StoreCta.astro';
import { SITE, url } from '../consts';

const features = [
  { t: 'Call button on the lock screen', b: 'A Call button opens the dialler. CamLock is designed to stand aside when Android reports a ringing or active call.' },
  { t: 'Fingerprint unlock only', b: "Unlocking uses Android's strong biometrics. There is no PIN fallback inside CamLock." },
  { t: 'CamLock itself needs your fingerprint', b: 'Opening the app asks for your fingerprint too.' },
  { t: 'A message per child', b: 'You write what the lock screen says to each child.' },
  { t: 'Tracking-only mode', b: 'Records who used the phone without locking it.' },
  { t: 'Activity history', b: 'Locks per day, time locked and per-child totals, with CSV export to a destination you choose.' },
  { t: 'Tamper alerts', b: 'CamLock alerts you when it detects that protection was interrupted. Delivery depends on Android and notification access.' },
];

const facts = [
  { t: 'Processing', b: 'Face detection and matching run on the phone. The app has no internet permission.' },
  { t: 'Face templates', b: 'Encrypted with an Android Keystore key. They are measurements, not photos.' },
  { t: 'In the app', b: 'No account, ads, analytics or crash reporting.' },
  { t: 'Exports', b: 'History goes where you choose to save it. A cloud destination can carry it off the phone.' },
];

const limits = [
  { t: 'Force-stopping', b: 'Any Android app can be force-stopped. CamLock can report an unexpected stop when it next runs.' },
  { t: 'Other fingerprints', b: 'Android accepts any enrolled fingerprint. A person who knows the device PIN may add another, so keep device credentials private.' },
  { t: 'Reboots', b: 'After a reboot, tap the reminder and authenticate. Protection can restart once its required access is ready.' },
];

const faqs = [
  { q: 'Does any face data leave the phone?', a: 'CamLock processes camera frames and face templates on the phone and does not upload them. Templates are encrypted biometric measurements, not saved photos. History is separate: you can export it to a destination you choose.' },
  { q: 'Does it lock for other adults?', a: 'CamLock tries to match only the children you enrolled. Recognition can make mistakes, especially with similar faces; check it with your household and adjust the sensitivity if needed.' },
  { q: 'Can it tell siblings apart?', a: 'Similar faces can be confused. Three sensitivity presets and additional samples help you adjust recognition, but reliable separation of siblings is not guaranteed.' },
  { q: 'What does it cost in battery?', a: 'Each check briefly uses the front camera. Battery use depends on your phone, settings and how often checks run; we do not promise a fixed percentage.' },
  { q: 'Which phones does it run on?', a: 'Android 8.0 and up, with a front camera and an enrolled fingerprint. It runs on the parent phone.' },
];

const live = SITE.playUrl.length > 0;
---

<Base title={`${SITE.name} | Phone locks itself when your child picks it up`}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="display reveal">CamLock locks your phone when it recognises your child</h1>
        <p class="lede reveal" style="--d:160ms">
          CamLock uses the front camera to recognise the children you enrolled and shows a
          calls-only lock screen. Your fingerprint unlocks it.
        </p>
        <div class="cta reveal" style="--d:240ms">
          {live ? (
            <>
              <StoreCta />
              <a class="btn btn-ghost" href="#how">See how it works</a>
            </>
          ) : (
            <a class="btn btn-primary" href="#how">See how it works</a>
          )}
        </div>
      </div>
      <div class="hero-art reveal" style="--d:120ms">
        <Phone mode="loop" step={1} tilt />
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <header class="head reveal">
        <h2>How it works</h2>
      </header>
      <Flow />
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <header class="head reveal">
        <h2>Features</h2>
        <p class="lede">Every feature is in the app from the start. Nothing is unlocked later.</p>
      </header>
      <ul class="rows reveal">
        {features.map((f) => (
          <li class="row">
            <h3>{f.t}</h3>
            <p>{f.b}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="privacy" class="band">
    <div class="wrap privacy">
      <div class="reveal">
        <h2>Face checks happen on the phone</h2>
        <p class="lede">
          Face templates are encrypted and matched on the phone. You choose where a history
          export is saved. A cloud destination can carry it off the phone, and copies are yours
          to delete.
        </p>
        <p><a href={url('/privacy')}>Read the privacy policy</a></p>
      </div>
      <dl class="facts reveal" style="--d:120ms">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.t}</dt>
            <dd>{f.b}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="limits">
    <div class="wrap">
      <header class="head reveal">
        <h2>Limits</h2>
        <p class="lede">CamLock is not a tamper-proof lock. Know these three limits before you rely on it.</p>
      </header>
      <div class="limits">
        {limits.map((l, i) => (
          <div class="limit reveal" style={`--d:${i * 80}ms`}>
            <h3>{l.t}</h3>
            <p>{l.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="band">
    <div class="wrap faqwrap">
      <header class="reveal">
        <h2>Questions</h2>
      </header>
      <div class="faq reveal" style="--d:100ms">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="get" class="final">
    <div class="wrap reveal">
      {live ? (
        <>
          <h2>Get CamLock on Google Play</h2>
          <StoreCta />
        </>
      ) : (
        <h2>Coming to Google Play</h2>
      )}
      <p class="req">Android 8.0 or later, with a front camera and an enrolled fingerprint.</p>
      <p class="fine">Face matching happens on your phone. See the <a href={url('/privacy')}>privacy policy</a>.</p>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(3rem, 9vw, 7rem) clamp(3rem, 7vw, 5rem); }
  .hero-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 58rem) {
    .hero-grid { grid-template-columns: 1.08fr 0.92fr; gap: 4rem; }
    /* Content starts just under the header, with padding that follows screen
       height, and the hero is as tall as its content. Centring it in a full
       screen spread the leftover height evenly, which always left an empty
       band above the headline (365px of it on a 1440px-tall monitor). The
       phone and headline are both sized to fit the screen, so nothing needs
       the extra height to stay visible. */
    .hero { padding-block: clamp(1.5rem, 6svh, 5rem) clamp(2.5rem, 8svh, 6rem); }
  }
  /* The phone is laid out in px against its 302x644 design size, so it scales
     with zoom, stepped by screen height to fit inside the hero's 2rem padding. */
  /* Each step fits 644px x zoom inside (screen height - 160px) at its lower bound. */
  @media (min-width: 58rem) and (max-height: 799px) {
    .hero-art :global(.phone) { width: 302px; zoom: 86%; }
  }
  @media (min-width: 58rem) and (max-height: 719px) {
    .hero-art :global(.phone) { zoom: 74%; }
  }
  @media (min-width: 58rem) and (max-height: 639px) {
    .hero-art :global(.phone) { zoom: 62%; }
  }
  @media (min-width: 58rem) and (max-height: 559px) {
    .hero-art :global(.phone) { zoom: 50%; }
  }
  /* Grid items default to min-width: auto, which lets any wide child stretch the
     column past the viewport. */
  .hero-copy { min-width: 0; container-type: inline-size; }
  /* Vanishing point off to the right: the phone is turned to face the headline,
     so its right side is the one we see, and a right-hand origin makes the
     perspective widen that side edge instead of shrinking it back. */
  .hero-art { display: flex; justify-content: center; min-width: 0; perspective: 1600px; perspective-origin: 140% 50%; }
  /* At full size the hero phone is taller than a phone screen, so the page opens
     with a screenful of mockup. Scale it the way the flow phone is scaled. */
  @media (max-width: 47.99rem) {
    .hero-art :global(.phone) { width: 302px; zoom: 62%; }
  }
  .cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  @media (max-width: 30rem) {
    .cta { display: grid; }
  }

  /* Section heads */
  .head { margin-bottom: clamp(2.5rem, 5vw, 4rem); max-width: 42rem; }
  .head .lede { margin-top: 1rem; }
  .band {
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.022) 18%, rgba(255, 255, 255, 0.022) 82%, transparent);
  }

  /* Feature rows: title left, text right, hairlines between */
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-soft); }
  .row {
    display: grid;
    gap: 0.4rem 3rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line-soft);
  }
  @media (min-width: 48rem) { .row { grid-template-columns: minmax(0, 18rem) minmax(0, 36rem); } }
  .row h3 { margin: 0; font-size: 1.0625rem; }
  .row p { margin: 0; color: var(--muted); font-size: 0.975rem; line-height: 1.55; }

  /* Privacy facts */
  .privacy { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 56rem) { .privacy { grid-template-columns: 1.05fr 0.95fr; gap: 4rem; } }
  .facts { margin: 0; border-top: 1px solid var(--line-soft); }
  .fact {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line-soft);
  }
  @media (min-width: 40rem) { .fact { grid-template-columns: 9rem minmax(0, 1fr); } }
  .fact dt { font-weight: 600; font-size: 0.95rem; }
  .fact dd { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.55; }

  /* Limits */
  .limits { display: grid; gap: 1.6rem; }
  @media (min-width: 52rem) { .limits { grid-template-columns: repeat(3, 1fr); gap: 2.4rem; } }
  .limit { border-top: 1px solid var(--line-soft); padding-top: 1.3rem; }
  .limit h3 { margin-bottom: 0.5rem; }
  .limit p { color: var(--muted); margin: 0; font-size: 0.95rem; }

  /* FAQ */
  .faqwrap { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 56rem) { .faqwrap { grid-template-columns: 0.75fr 1.25fr; gap: 4rem; } }
  .faq details { border-bottom: 1px solid var(--line-soft); }
  .faq details:first-child { border-top: 1px solid var(--line-soft); }
  .faq summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: center;
    padding: 1.15rem 0;
    font-size: 1.05rem;
    font-weight: 550;
    letter-spacing: -0.015em;
    transition: color 0.2s;
  }
  .faq summary:hover { color: var(--brand); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '';
    flex: none;
    width: 11px; height: 11px;
    border-right: 1.5px solid var(--brand);
    border-bottom: 1.5px solid var(--brand);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.3s var(--ease);
  }
  .faq details[open] summary::after { transform: rotate(225deg) translate(-2px, -2px); }
  .faq p { color: var(--muted); margin: -0.25rem 0 1.3rem; max-width: 58ch; font-size: 0.975rem; }

  /* Final */
  .final { text-align: center; padding-bottom: clamp(5rem, 12vw, 9rem); }
  .final h2 { margin-bottom: 1.5rem; }
  .req { color: var(--muted); margin: 0 auto 0.75rem; max-width: 40ch; }
  .fine { color: var(--dim); font-size: 0.875rem; margin: 0; }
  .fine a { color: var(--muted); }
</style>
